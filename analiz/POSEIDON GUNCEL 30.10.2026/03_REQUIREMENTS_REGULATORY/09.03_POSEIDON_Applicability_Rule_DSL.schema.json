{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poseidon.example/schemas/applicability-rule.schema.json",
  "title": "POSEIDON v46.2 Applicability Rule",
  "type": "object",
  "required": [
    "ruleId",
    "version",
    "source",
    "lifecycle",
    "scope",
    "when",
    "then",
    "unknownPolicy"
  ],
  "properties": {
    "ruleId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "titleTr": {
      "type": "string"
    },
    "titleEn": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "sourceId",
        "locator",
        "authorityLayer"
      ],
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "authorityLayer": {
          "enum": [
            "INTERNATIONAL",
            "FLAG",
            "CLASS_RO",
            "COMPANY_SMS",
            "OEM",
            "INDUSTRY_ASSURANCE",
            "PRODUCT_CONTROL"
          ]
        },
        "mandatory": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "state",
        "effectiveFrom"
      ],
      "properties": {
        "state": {
          "enum": [
            "DRAFT",
            "ADOPTED",
            "AWAITING",
            "FUTURE_EFFECTIVE",
            "IN_FORCE",
            "SUPERSEDED"
          ]
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date"
        },
        "effectiveTo": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "SHIP",
              "TUG"
            ]
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classSocieties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vesselTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operationTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "when": {
      "$ref": "#/$defs/expression"
    },
    "then": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE",
            "REVIEW_REQUIRED"
          ]
        },
        "activate": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "enum": [
                  "REQUIREMENT",
                  "CONTROL",
                  "SCREEN",
                  "FIELD",
                  "EVIDENCE_POLICY",
                  "VERIFICATION_GATE",
                  "TEST_CASE",
                  "NOTIFICATION"
                ]
              },
              "id": {
                "type": "string"
              }
            }
          }
        },
        "stateEffect": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasonCode": {
          "type": "string"
        }
      }
    },
    "unknownPolicy": {
      "enum": [
        "REVIEW_REQUIRED",
        "NOT_APPLICABLE",
        "FAIL_CLOSED"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "requiresHumanReview": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exampleOnly": {
      "type": "boolean",
      "description": "True rules are illustrative fixtures and MUST NOT enter authoritative published rule sets."
    },
    "publicationStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "APPROVED",
        "PUBLISHED"
      ],
      "description": "Authoring workflow independent of legal instrument lifecycle; PUBLISHED requires approved source verification and second-person approval."
    },
    "sourceVerificationStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "VERIFIED",
        "REJECTED"
      ],
      "description": "PENDING/REJECTED source claims cannot produce authoritative activation or READY. Only non-mutating labelled simulation may show illustrative outputs."
    }
  },
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "field",
            "operator"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "enum": [
                "EQ",
                "NE",
                "GT",
                "GTE",
                "LT",
                "LTE",
                "IN",
                "NOT_IN",
                "EXISTS",
                "IS_TRUE",
                "IS_FALSE",
                "DATE_GTE",
                "DATE_LT",
                "CONTAINS"
              ]
            },
            "value": {}
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "EQ",
                      "NE",
                      "CONTAINS"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {}
                }
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "GT",
                      "GTE",
                      "LT",
                      "LTE"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": "number"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "IN",
                      "NOT_IN"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "DATE_GTE",
                      "DATE_LT"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "EXISTS",
                      "IS_TRUE",
                      "IS_FALSE"
                    ]
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "value"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  },
  "description": "Controlled candidate DSL; structural validity is not legal/source approval. Publication additionally requires semantic validation, binding validation, golden tests and independent human approval.",
  "allOf": [
    {
      "if": {
        "required": [
          "publicationStatus"
        ],
        "properties": {
          "publicationStatus": {
            "const": "PUBLISHED"
          }
        }
      },
      "then": {
        "required": [
          "exampleOnly",
          "sourceVerificationStatus"
        ],
        "properties": {
          "exampleOnly": {
            "const": false
          },
          "sourceVerificationStatus": {
            "const": "VERIFIED"
          }
        }
      }
    }
  ]
}
