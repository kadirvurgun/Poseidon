# Client UI only. Backend must independently enable SyntheticIdentity:Enabled.
# Never enable synthetic identity in a public/production deployment.
VITE_ENABLE_DEV_SESSION=false

# Optional same-origin BFF UI. Requires separately approved server infrastructure.
# When true, this hides the bearer/manual-token and synthetic UI; no automatic fallback.
VITE_ENABLE_BFF=false
